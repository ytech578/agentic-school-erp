[Unit]
Description=Encrypted Authentik backup with verified private R2 copy
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service
OnFailure=school-erp-identity-backup-monitor.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/flock --nonblock --conflict-exit-code=75 /var/lib/school-erp-identity-backup/job.lock /opt/school-erp-backup/node /opt/school-erp-backup/scripts/dr/scheduled-identity-backup.js run /etc/school-erp-backup/config.json
TimeoutStartSec=10min
TimeoutStopSec=15s
KillMode=control-group
MemoryMax=1G
TasksMax=128
CPUQuota=100%
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/school-erp-identity-backup
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LimitCORE=0

# Host Docker administration is required: this is NOT an application container.
# The separate six-minute resume watchdog is armed before any identity stop.
