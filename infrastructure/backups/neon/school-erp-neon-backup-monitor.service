[Unit]
Description=Check Neon backup age, integrity, remote receipt and failure alerts
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/flock --nonblock --conflict-exit-code=0 /var/lib/school-erp-neon-backup/job.lock /opt/school-erp-neon-backup/node /opt/school-erp-neon-backup/scripts/dr/scheduled-neon-backup.js monitor /etc/school-erp-neon-backup/config.json
TimeoutStartSec=90s
KillMode=control-group
MemoryMax=512M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/school-erp-neon-backup
LimitCORE=0
