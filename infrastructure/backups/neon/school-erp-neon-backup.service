[Unit]
Description=Independent encrypted Neon ERP backup with verified private R2 copy
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service
OnFailure=school-erp-neon-backup-monitor.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/flock --nonblock --conflict-exit-code=75 /var/lib/school-erp-neon-backup/job.lock /opt/school-erp-neon-backup/node /opt/school-erp-neon-backup/scripts/dr/scheduled-neon-backup.js run /etc/school-erp-neon-backup/config.json
ExecStopPost=/opt/school-erp-neon-backup/node /opt/school-erp-neon-backup/scripts/dr/scheduled-neon-backup.js cleanup /etc/school-erp-neon-backup/config.json
TimeoutStartSec=10min
TimeoutStopSec=60s
KillMode=control-group
MemoryMax=1G
TasksMax=128
CPUQuota=100%
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/school-erp-neon-backup
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LimitCORE=0
