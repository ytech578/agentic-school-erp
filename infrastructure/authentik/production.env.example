# Copy to an ignored operator-owned file; never use development bootstrap tokens.
# Each school installation must have distinct database credentials and secret key.
AUTHENTIK_PG_PASSWORD=
AUTHENTIK_SECRET_KEY=
AUTHENTIK_DOMAIN=
AUTHENTIK_BIND_ADDRESS=
AUTHENTIK_HTTPS_PORT=443
AUTHENTIK_TLS_DIRECTORY=
# Size after load testing; the development caps are not a production sizing claim.
AUTHENTIK_SERVER_MEMORY_LIMIT=2048m
AUTHENTIK_WORKER_MEMORY_LIMIT=1536m
