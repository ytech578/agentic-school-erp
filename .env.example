# ============================================================
# AI School ERP V1.0 — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ============================================================
# APPLICATION
# ============================================================
NODE_ENV=development
APP_NAME="AI School ERP"
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PREFIX=api
PORT=4000

# ============================================================
# DATABASE (PostgreSQL via Docker)
# ============================================================
DATABASE_URL="postgresql://school_erp:school_erp_dev_2026@localhost:5432/school_erp_dev?schema=public"

# ============================================================
# REDIS (via Docker)
# ============================================================
REDIS_URL="redis://:redis_dev_2026@localhost:6379"
REDIS_PASSWORD=redis_dev_2026

# ============================================================
# JWT AUTHENTICATION
# Generate strong secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ============================================================
JWT_ACCESS_SECRET=CHANGE_THIS_TO_A_STRONG_64_CHAR_SECRET_FOR_ACCESS_TOKEN
JWT_REFRESH_SECRET=CHANGE_THIS_TO_A_DIFFERENT_64_CHAR_SECRET_FOR_REFRESH_TOKEN
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ============================================================
# AI PROVIDER (Google Gemini)
# Get free API key: https://ai.google.dev
# ============================================================
AI_PROVIDER=gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-1.5-flash

# ============================================================
# EMAIL (Nodemailer)
# For development, use Gmail with App Password:
# Gmail → Settings → Security → 2FA → App Passwords → Generate
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your.school.erp@gmail.com
SMTP_PASS=YOUR_GMAIL_APP_PASSWORD
SMTP_FROM="AI School ERP <your.school.erp@gmail.com>"

# ============================================================
# FILE STORAGE
# ============================================================
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
# Future S3 config:
# STORAGE_PROVIDER=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_S3_REGION=

# ============================================================
# SCHOOL CONFIGURATION (Single School MVP)
# ============================================================
DEFAULT_SCHOOL_NAME="Demo School"
DEFAULT_SCHOOL_TIMEZONE=Asia/Kolkata
DEFAULT_SCHOOL_CURRENCY=INR

# ============================================================
# SECURITY
# ============================================================
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5
SESSION_TIMEOUT_HOURS=24

# ============================================================
# SEEDING & DEMO CONFIGURATION
# ============================================================
# Password used when seeding development/demo accounts.
# Required when running seed scripts in development. Never commit real passwords.
DEMO_PASSWORD=your_secure_demo_password_here
# Explicit guard to allow/deny seeding demo data (must be explicitly 'true' to run in production)
SEED_DEMO_DATA=false

# ============================================================
# CORS
# ============================================================
CORS_ORIGIN=http://localhost:3000

# ============================================================
# FRONTEND (Next.js - prefix NEXT_PUBLIC_ for client-side)
# ============================================================
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_APP_NAME="AI School ERP"
NEXT_PUBLIC_APP_VERSION=1.0.0
