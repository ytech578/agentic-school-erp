# ============================================================
# AI School ERP V1.0 — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ============================================================
# APPLICATION
# ============================================================
NODE_ENV=development
# Deployment choice applies per installation, not by moving tenant files between servers.
ERP_DEPLOYMENT_MODE=development
# Runtime process loads injected/.env.runtime values only when true.
APP_RUNTIME_ENV_ONLY=false
ON_PREMISES_DATABASE_HOSTS=localhost,127.0.0.1,postgres,pgbouncer
ON_PREMISES_ALLOW_EXTERNAL_AI=false
APP_NAME="AI School ERP"
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PREFIX=api
PORT=4000

# ============================================================
# DATABASE (PostgreSQL via Docker)
# ============================================================
DATABASE_URL="postgresql://school_erp:school_erp_dev_2026@localhost:5432/school_erp_dev?schema=public"
# Optional staging target: a dedicated ERP Neon database, not another app's DB.
# Set locally in apps/api/.env, then run npm run db:neon:check (read-only).
# This does not change the application's active DATABASE_URL.
NEON_DATABASE_URL=
# After verified cutover: pooled restricted-role URL for DATABASE_URL,
# direct owner URL only for migration/backup tools. Preserve localhost fallback.
NEON_RUNTIME_DATABASE_URL=
MIGRATION_DATABASE_URL=
LOCAL_DATABASE_URL=
# Generate locally: node scripts/dr/neon-backup.js init-key
# Keep a separate secure recovery copy; do not rotate without re-encrypting backups.
BACKUP_ENCRYPTION_KEY=
# Optional independently provisioned/synchronized recovery directory.
# A second local directory alone is NOT a cross-region backup.
BACKUP_SECONDARY_DIRECTORY=
BACKUP_MAX_AGE_HOURS=26
# Optional notification recipient. No alerts are sent until explicitly configured.
BACKUP_ALERT_EMAIL=
# Audit exports are encrypted locally until an approved independent store exists.
AUDIT_EXPORT_DATABASE_URL=
AUDIT_EXPORT_ENCRYPTION_KEY=
# Docker/production uses separate owner and runtime identities. DB_USER runs
# migrations only; the API and PgBouncer must use the NOBYPASSRLS runtime role.
DB_USER=school_erp_owner
DB_PASSWORD=CHANGE_THIS_DATABASE_OWNER_PASSWORD
DB_NAME=school_erp
DB_RUNTIME_USER=school_erp_runtime
DB_RUNTIME_PASSWORD=CHANGE_THIS_DISTINCT_RUNTIME_PASSWORD
# Production only: enable PostgreSQL RLS and connect as the NOBYPASSRLS
# runtime role created by scripts/db/configure-runtime-role.sql.
DATABASE_RLS_ENABLED=false
PRISMA_TRANSACTION_MAX_WAIT_MS=5000
PRISMA_TRANSACTION_TIMEOUT_MS=30000

# ============================================================
# REDIS (via Docker)
# ============================================================
REDIS_URL="redis://:redis_dev_2026@localhost:6379"
REDIS_PASSWORD=redis_dev_2026

# ============================================================
# JWT AUTHENTICATION
# Generate strong, distinct 64-character random secrets:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Must be at least 32 characters, distinct from each other, and not contain placeholders.
# ============================================================
JWT_ACCESS_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_REFRESH_SECRET=CHANGE_THIS_TO_A_DIFFERENT_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ============================================================
# AI PROVIDER (Google Gemini)
# Get free API key: https://ai.google.dev
# ============================================================
AI_PROVIDER=gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-1.5-flash

# ============================================================
# EMAIL (Nodemailer)
# For development, use Gmail with App Password:
# Gmail → Settings → Security → 2FA → App Passwords → Generate
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your.school.erp@gmail.com
SMTP_PASS=YOUR_GMAIL_APP_PASSWORD
SMTP_FROM="AI School ERP <your.school.erp@gmail.com>"

# ============================================================
# FILE STORAGE
# ============================================================
STORAGE_DRIVER=local
# STORAGE_PROVIDER is accepted as a backwards-compatible alias.
STORAGE_LOCAL_PATH=./uploads
# Private S3-compatible storage for cloud-hosted schools (R2/B2/S3/MinIO).
# Keep local for school-controlled on-premises deployments.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Legacy AWS aliases remain supported:
# STORAGE_PROVIDER=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# S3_BUCKET_NAME= # preferred name; AWS_S3_BUCKET is accepted for compatibility
# AWS_S3_REGION=

# ============================================================
# SCHOOL CONFIGURATION (Single School MVP)
# ============================================================
DEFAULT_SCHOOL_NAME="Demo School"
DEFAULT_SCHOOL_TIMEZONE=Asia/Kolkata
DEFAULT_SCHOOL_CURRENCY=INR

# ============================================================
# SECURITY
# ============================================================
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5
SESSION_TIMEOUT_HOURS=24
PII_ENCRYPTION_KEY=CHANGE_THIS_TO_A_STRONG_RANDOM_64_HEX_CHARACTER_KEY
MFA_RECOVERY_CODE_PEPPER=CHANGE_THIS_TO_A_DISTINCT_RANDOM_SECRET
MFA_ISSUER="Agentic School ERP"
BREAK_GLASS_REQUIRED=false

# Enterprise document security. Production always fails closed when ClamAV is
# unavailable, regardless of MALWARE_SCAN_REQUIRED.
MALWARE_SCAN_REQUIRED=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000
DOCUMENT_RETENTION_DAYS=2555

# ============================================================
# SEEDING & DEMO CONFIGURATION
# ============================================================
# Password used when seeding development/demo accounts.
# Required when running seed scripts in development. Never commit real passwords.
DEMO_PASSWORD=your_secure_demo_password_here
# Explicit guard to allow/deny seeding demo data (must be explicitly 'true' to run in production)
SEED_DEMO_DATA=false

# ============================================================
# CORS
# ============================================================
CORS_ORIGIN=http://localhost:3000

# ============================================================
# FRONTEND (Next.js - prefix NEXT_PUBLIC_ for client-side)
# ============================================================
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_APP_NAME="AI School ERP"
NEXT_PUBLIC_APP_VERSION=1.0.0

# ============================================================
# CDN (Content Delivery Network) — Phase 5
# ============================================================
# Set to your CDN base URL to serve static assets from CDN.
# Leave empty to serve from the application server (default).
# Example: https://cdn.yourschool.in
# Example (CloudFront): https://d1234567890.cloudfront.net
NEXT_PUBLIC_CDN_URL=

# ============================================================
# SECRET ROTATION TRACKING — Phase 5
# ============================================================
# Auto-populated by: node scripts/db/rotate-secrets.js
# Previous secrets kept for grace-period JWT verification
# JWT_ACCESS_SECRET_PREV=
# JWT_REFRESH_SECRET_PREV=
SECRET_ROTATION_DATE=
SECRET_ROTATION_BY=

# ============================================================
# BLUE/GREEN DEPLOYMENT — Phase 5
# ============================================================
# Identifies which deployment slot this instance is running in.
# Set by docker-compose.blue-green.yml automatically.
DEPLOY_SLOT=blue
