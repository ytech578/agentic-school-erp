{
  "name": "ai-school-erp",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "predev": "node scripts/dev-preflight.js",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run start:dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces --if-present",
    "test:ops": "node --test scripts/db/*.test.js scripts/dr/*.test.js scripts/ops/*.test.js",
    "test:cov": "npm run test:cov --workspace=apps/api",
    "lint": "npm run lint --workspaces --if-present",
    "lint:prune": "npm run lint --workspaces --if-present -- --prune-suppressions",
    "ci:verify": "npm run build --workspace=packages/shared && npm run lint && npm run typecheck && npm run test:ops && npm run test:cov --workspace=apps/api -- --runInBand --forceExit && npm run test --workspace=apps/web -- --runInBand --forceExit",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:migrate": "npm run db:migrate --workspace=apps/api",
    "db:seed": "npm run db:seed --workspace=apps/api",
    "db:studio": "npm run db:studio --workspace=apps/api",
    "db:status": "node scripts/db/migrate.js status",
    "db:neon:check": "node scripts/db/check-neon.js",
    "db:neon:backup": "node scripts/dr/neon-backup.js backup",
    "db:backup:health": "node scripts/dr/check-backup-health.js",
    "ops:runtime-env": "node scripts/ops/export-runtime-env.js",
    "ops:audit:export": "node scripts/ops/export-audit.js",
    "identity:init": "node scripts/ops/init-authentik.js",
    "identity:development:init": "node scripts/ops/init-identity-development.js",
    "identity:fixture": "node scripts/ops/prepare-identity-fixture.js",
    "identity:verify:local": "node scripts/ops/verify-identity-local.js",
    "identity:verify:federation": "node scripts/ops/verify-identity-federation.js --lifecycle --negative-mfa",
    "identity:backup": "node scripts/dr/identity-recovery.js backup",
    "identity:backup:verify": "node scripts/dr/identity-recovery.js verify",
    "identity:restore:drill": "node scripts/dr/identity-recovery.js drill",
    "school:readiness": "node scripts/ops/school-readiness.js",
    "db:neon:backup:verify": "node scripts/dr/neon-backup.js verify",
    "db:neon:restore:drill": "node scripts/dr/neon-backup.js drill",
    "db:backup": "node scripts/db/migrate.js backup",
    "db:rollback": "node scripts/db/migrate.js rollback",
    "db:list": "node scripts/db/migrate.js list",
    "secrets:rotate": "node scripts/db/rotate-secrets.js",
    "docker:dev": "docker compose -f docker-compose.dev.yml up -d --wait",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
    "docker:prod": "docker compose up -d --wait",
    "docker:prod:down": "docker compose down",
    "docker:blue-green": "docker compose -f docker-compose.blue-green.yml up -d --wait",
    "deploy:green": "docker compose -f docker-compose.blue-green.yml up -d --wait api_green web_green",
    "deploy:flip": "node -e \"require('fs').writeFileSync('nginx.env','ACTIVE_SLOT='+process.argv[1]);\" --"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
